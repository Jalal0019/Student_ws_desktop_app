{
  "name": "bigdata-attendance-app",
  "version": "1.0.0",
  "description": "Desktop app for the Big Data AI Club Attendance & Grades system",
  "main": "main.js",
  "author": "Big Data Artificial Intelligence Club — University of Baghdad, College of AI",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist": "electron-builder --win --mac"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "iq.edu.uobaghdad.coai.bigdataclub.attendance",
    "productName": "BigData Attendance",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "app-ui/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.education"
    }
  }
}
